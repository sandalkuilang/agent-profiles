{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Profiles",
  "version": "0.2.0",
  "identifier": "com.husniadil.agent-profiles",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:17420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Agent Profiles",
        "width": 800,
        "height": 600,
        "minWidth": 560,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/husniadil/agent-profiles/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1Q0Y1MUFCRTRDQ0UwNUUKUldSZTRNemtxMUhQcFllUEY3emZmcFk3UnJaYmtWTU9JNmJQUUNabnVxNWFkWktCRUJEODRQdHgK",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
